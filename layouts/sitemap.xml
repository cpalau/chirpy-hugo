{{ "<?xml version=\"1.0\" encoding=\"UTF-8\"?>" | safeHTML }}
{{- /* Mirrors jekyll-sitemap's content: posts, the tab pages, the home page,
       the taxonomy indexes and terms, and the pagination pages. Hugo's default
       template adds the section list page (`/posts/`), which has no Jekyll
       counterpart, and skips pagination.
       Pagination URLs use Hugo's shape (`/page/2/`); the difference from
       Jekyll's `/page2/` is declared as D-14. Order is not significant in a
       sitemap; the set is what this gate compares. */ -}}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.sitemaps.org/schemas/sitemap/0.9 http://www.sitemaps.org/schemas/sitemap/0.9/sitemap.xsd">
{{- $urls := slice -}}
{{- range sort (where .Site.RegularPages "Section" "posts") "Date" "asc" -}}
  {{- $urls = $urls | append (dict "loc" .Permalink "lastmod" (.Lastmod.Format "2006-01-02T15:04:05-07:00")) -}}
{{- end -}}
{{- range sort (where .Site.Pages "Kind" "taxonomy") "Permalink" "asc" -}}
  {{- $urls = $urls | append (dict "loc" .Permalink "lastmod" (.Date.Format "2006-01-02T15:04:05-07:00")) -}}
{{- end -}}
{{- range sort (where .Site.RegularPages "Section" "") "Params.order" "asc" -}}
  {{- $urls = $urls | append (dict "loc" .Permalink "lastmod" (.Date.Format "2006-01-02T15:04:05-07:00")) -}}
{{- end -}}
{{- $urls = $urls | append (dict "loc" .Site.Home.Permalink) -}}
{{- range $taxonomy := slice "tags" "categories" -}}
  {{- with index $.Site.Taxonomies $taxonomy -}}
    {{- range $term, $weighted := . -}}
      {{- with $.Site.GetPage (printf "/%s/%s" $taxonomy $term) -}}
        {{- $urls = $urls | append (dict "loc" .Permalink) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- with .Site.Home.Paginate (partial "posts-visible.html" .) -}}
  {{- range .Pagers -}}
    {{- if gt .PageNumber 1 -}}
      {{- $urls = $urls | append (dict "loc" (.URL | absURL)) -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- /* Beyond upstream (opt-in guard): a sitemap may contain at most 50,000
       URLs. There is no supported way for a theme to split one automatically,
       so fail loudly with the count and the documented options. */ -}}
{{- $limit := site.Params.seo.sitemap_limit | default 50000 -}}
{{- if gt (len $urls) (int $limit) -}}
  {{- warnf "sitemap.xml has %d URLs, over the configured limit of %d. Split it (per-section sitemaps plus a sitemapindex, or Hugo's per-language sitemapindex) before publishing; see docs/CONFIG.md §12." (len $urls) (int $limit) -}}
{{- end -}}
{{- range $urls }}
  <url>
    <loc>{{ .loc | safeHTML }}</loc>
    {{- with .lastmod }}
    <lastmod>{{ . | safeHTML }}</lastmod>
    {{- end }}
  </url>
{{- end }}
</urlset>
