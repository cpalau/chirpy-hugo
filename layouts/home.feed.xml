{{- /* Ports `assets/feed.xml`, the hand-written Atom feed (F6).
       Five most recent posts, a 400-character summary and upstream's own
       `&`-escaping rule: the finished document is escaped once, so a literal
       `&` anywhere becomes `&amp;`. Values are inserted raw because that is
       what Liquid produced before the final `replace`. */ -}}
{{- $site := .Site -}}
{{- $author := $site.Params.social.name -}}
{{- $lang := $site.Params.alt_lang | default $site.Language.Lang -}}
{{- $home := "" | absURL -}}
{{- $body := printf `<feed xmlns="http://www.w3.org/2005/Atom">
  <id>%s</id>
  <title>%s</title>
  <subtitle>%s</subtitle>
  <updated>%s</updated>
  <author>
    <name>%s</name>
    <uri>%s</uri>
  </author>
  <link rel="self" type="application/atom+xml" href="%s"/>
  <link rel="alternate" type="text/html" hreflang="%s"
    href="%s"/>
  <generator uri="https://gohugo.io/" version="%s">Hugo</generator>
  <rights> © %d %s </rights>
  <icon>%s</icon>
  <logo>%s</logo>
` $home $site.Title ($site.Params.description | default "") (now.Format "2006-01-02T15:04:05-07:00") $author $home (printf "%sfeed.xml" $home) $lang $home hugo.Version now.Year $author (relURL "assets/img/favicons/favicon.ico") (relURL "assets/img/favicons/favicon-96x96.png") -}}
{{- range first 5 $site.RegularPages -}}
  {{- $url := .Permalink -}}
  {{- $updated := .Lastmod -}}
  {{- $summary := partial "post-summary.html" (dict "post" . "max_length" 400) -}}
  {{- /* Upstream escapes the link title attribute with `xml_escape`; the rest of
         the document is escaped once, at the end, with the `&` replacement. */ -}}
  {{- $titleAttr := partial "xml-escape.html" .Title -}}
  {{- $categories := "" -}}
  {{- with .Params.categories -}}
    {{- range . -}}{{- $categories = printf `%s
    <category term="%s" />` $categories . -}}{{- end -}}
  {{- end -}}
  {{- $body = printf `%s
  <entry>
    <title>%s</title>
    <link href="%s" rel="alternate" type="text/html" title="%s" />
    <published>%s</published>
    <updated>%s</updated>
    <id>%s</id>
    <content type="text/html" src="%s" />
    <author>
      <name>%s</name>
    </author>%s
    <summary>%s</summary>

  </entry>` $body .Title $url $titleAttr (.Date.Format "2006-01-02T15:04:05-07:00") ($updated.Format "2006-01-02T15:04:05-07:00") $url $url (.Params.author | default $author) $categories $summary -}}
{{- end -}}
{{- printf "%s\n</feed>" (replace $body "&" "&amp;") | safeHTML -}}
