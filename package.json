{
  "name": "chirpy-hugo",
  "version": "0.1.0",
  "private": true,
  "description": "Hugo port of jekyll-theme-chirpy \u2014 verification harness",
  "type": "module",
  "scripts": {
    "build": "hugo --panicOnWarning --gc --minify",
    "build:css": "bash scripts/build-css.sh",
    "build:example": "hugo -s exampleSite --themesDir ../.. --theme chirpy-hugo --panicOnWarning -d ../.out/example",
    "build:js": "node scripts/build-js.mjs",
    "i18n": "node scripts/i18n.mjs --apply",
    "prepare": "husky",
    "screenshot": "node scripts/screenshot.mjs",
    "test:a11y": "node tests/a11y/check.mjs .out/hugo .out/oracle",
    "test:adoption": "node tests/adoption/check.mjs",
    "test:build": "node tests/build/check.mjs",
    "test:commit": "commitlint --from origin/main --to HEAD",
    "test:contract": "node tests/contract/selectors.mjs",
    "test:html": "node tests/html/check.mjs",
    "test:i18n": "node scripts/i18n.mjs --check",
    "test:interactive": "node tests/interactive/check.mjs",
    "test:outputs": "node tests/outputs/check.mjs",
    "test:parity": "node tests/parity/diff.mjs",
    "test:qa": "node tests/qa/q1-word-count.mjs && node tests/qa/q2-jsonify.mjs && node tests/qa/q3-page-order.mjs && node tests/qa/q4-sort-natural.mjs",
    "test:upstream": "node scripts/fetch-upstream.mjs --check && node scripts/extract-params.mjs --check",
    "test:visual": "node tests/visual/capture.mjs oracle && node tests/visual/capture.mjs hugo && node tests/visual/compare.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "axe-core": "^4.14.0",
    "html-validate": "^9.7.1",
    "husky": "^9.1.7",
    "parse5": "^7.2.1",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.1"
  }
}
