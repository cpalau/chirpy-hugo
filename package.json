{
  "name": "chirpy-hugo",
  "version": "1.5.0",
  "private": true,
  "description": "Hugo port of jekyll-theme-chirpy — verification harness",
  "type": "module",
  "scripts": {
    "build": "hugo --panicOnWarning --gc --minify",
    "build:css": "bash scripts/build-css.sh",
    "build:example": "hugo -s exampleSite --themesDir ../.. --theme chirpy-hugo --panicOnWarning -d ../.out/example",
    "build:js": "node scripts/build-js.mjs",
    "convert-content": "node scripts/convert-content.mjs",
    "i18n": "node scripts/i18n.mjs --apply",
    "prepare": "husky",
    "release:notes": "node scripts/release.mjs --notes",
    "release:prepare": "node scripts/release.mjs --prepare",
    "screenshot": "node scripts/screenshot.mjs",
    "sync:apply": "node scripts/sync-upstream.mjs --apply",
    "sync:report": "node scripts/sync-upstream.mjs",
    "test:a11y": "node tests/a11y/check.mjs .out/hugo .out/oracle",
    "test:adoption": "node tests/adoption/check.mjs",
    "test:browsers": "node tests/browsers/check.mjs",
    "test:build": "node tests/build/check.mjs",
    "test:commit": "commitlint --from origin/main --to HEAD",
    "test:config": "node scripts/check-config.mjs",
    "test:contract": "node tests/contract/selectors.mjs",
    "test:deploy": "node tests/adoption/check.mjs --deploy-only",
    "test:fast": "npm run -s test:build && npm run -s test:deploy && npm run -s test:ui && npm run -s test:html && npm run -s test:outputs && npm run -s test:seo:demo && npm run -s test:seo:ext",
    "test:features": "node tests/adoption/check.mjs --features-only",
    "test:html": "node tests/html/check.mjs",
    "test:i18n": "node scripts/i18n.mjs --check",
    "test:interactive": "node tests/ui/check.mjs",
    "test:outputs": "node tests/outputs/check.mjs",
    "test:parity": "node tests/parity/diff.mjs",
    "test:perf": "node tests/performance/check.mjs",
    "test:plugins": "node tests/plugins/check.mjs",
    "test:qa": "node tests/qa/q1-word-count.mjs && node tests/qa/q2-jsonify.mjs && node tests/qa/q3-page-order.mjs && node tests/qa/q4-sort-natural.mjs",
    "test:release": "node scripts/release.mjs --check",
    "test:seo": "node tests/seo/check.mjs",
    "test:seo:demo": "hugo -s exampleSite --themesDir ../.. --theme chirpy-hugo --baseURL https://example.com/chirpy-hugo/ --minify --panicOnWarning -d .out/example-deploy && node tests/seo/check.mjs --standards .out/example-deploy",
    "test:seo:ext": "node tests/seo/extensions.mjs",
    "test:ui": "node tests/ui/check.mjs",
    "test:ui:fast": "node tests/ui/check.mjs --fast",
    "test:upstream": "node scripts/fetch-upstream.mjs --check && node scripts/extract-params.mjs --check",
    "test:vendor": "node scripts/vendor.mjs --check",
    "test:visual": "node scripts/visual-run.mjs",
    "vendor:apply": "node scripts/vendor.mjs --apply",
    "vendor:check": "node scripts/vendor.mjs --check",
    "vendor:generate": "node scripts/vendor.mjs --generate"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "axe-core": "^4.14.0",
    "chrome-launcher": "^1.2.2",
    "html-validate": "^9.7.1",
    "husky": "^9.1.7",
    "lighthouse": "^12.8.2",
    "parse5": "^7.2.1",
    "pixelmatch": "^8.0.0",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "yaml": "^2.9.1"
  }
}
